{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "NYXERON",
  "description": "A nightclub game on NEAR where every drink is a real share.",
  "colors": {
    "primary": "#DD47FC",
    "light": "#E58CFF",
    "dark": "#914DFF"
  },
  "logo": {
    "light": "/logo/mark-black.svg",
    "dark": "/logo/mark-white.svg",
    "href": "https://nyxeron.xyz"
  },
  "favicon": "/favicon.svg",
  "fonts": {
    "family": "Geist"
  },
  "background": {
    "color": {
      "light": "#120826",
      "dark": "#090319"
    }
  },
  "appearance": {
    "default": "dark",
    "strict": true
  },
  "styling": {
    "codeblocks": "dark"
  },
  "navbar": {
    "links": [
      {
        "label": "Proof",
        "href": "https://app.nyxeron.xyz/proof"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Launch app",
      "href": "https://app.nyxeron.xyz"
    }
  },
  "navigation": {
    "groups": [
      {
        "group": "Get started",
        "pages": ["index", "quickstart"]
      },
      {
        "group": "The game",
        "pages": ["how-a-night-works"]
      },
      {
        "group": "How it works on NEAR",
        "pages": ["money-flow", "real-shares", "contract"]
      },
      {
        "group": "Reference",
        "pages": ["api-reference", "faq"]
      }
    ]
  },
  "footer": {
    "socials": {
      "website": "https://nyxeron.xyz"
    }
  }
}
