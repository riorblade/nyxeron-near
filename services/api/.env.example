# Copy to services/api/.env (git ignores it). Read once at start; a missing or bad value stops the server.
PORT=8788
# SQLite lives here (outside src, ignored by git).
DATA_DIR=.data
# Privy dashboard → app settings. The secret never leaves the server.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Comma-separated emails with full back-office access.
OWNER_EMAILS=
NEAR_NETWORK=testnet
# Testnet only: "Get demo credits" for judges. The server refuses to start with it on mainnet.
DEMO_MODE=false
