# Copy to services/api/.env (git ignores it). Read once at start; a missing or bad value stops the server.
PORT=8788
# SQLite lives here (outside src, ignored by git).
DATA_DIR=.data
# Privy dashboard → app settings. The secret never leaves the server.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Comma-separated emails with full back-office access.
OWNER_EMAILS=
NEAR_NETWORK=testnet
# Testnet only: "Get demo credits" for judges. The server refuses to start with it on mainnet.
DEMO_MODE=false
# Relayer: pays players' gas and the 1 yocto their payments need. Leave empty to switch /api/relay and /api/onboard off.
RELAYER_ACCOUNT_ID=
RELAYER_KEY=
# Our contract (default nyxeron.testnet on testnet) and USDC (default: Circle's USDC for the network).
CONTRACT_ID=
USDC_CONTRACT_ID=
# ed25519 secret for drink quotes (the contract's set_quote_key gets its public key). Without it, quotes answer 503.
QUOTE_KEY=
# Testnet + DEMO_MODE: "Get test dollars" sends this much Circle testnet USDC (micro-USDC, default 3000000 = $3) from
# the relayer, once a day per player. Top the relayer up by hand from Circle's faucet.
# TEST_DOLLARS=3000000
